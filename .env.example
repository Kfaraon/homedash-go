# Homedash environment variables
PORT=5000
TZ=Asia/Yekaterinburg
CONFIG_FILE=./data/config.json
ICONS_CONFIG_PATH=./data/icons.json

# API-ключ админ-панели удалён: админка работает без авторизации.
# Ограничивайте доступ к ней на уровне сети или обратного прокси.

# Таймауты проверок
CHECK_TIMEOUT=5s
PING_TIMEOUT=5s

# WAN IP settings
# Провайдеры вне VPN-маршрутов (Cloudflare-сервисы могут уходить в VPN и
# показывать адрес VPN вместо реального WAN).
IP_PROVIDERS=https://checkip.amazonaws.com,https://ifconfig.me/ip,https://ipinfo.io/ip,https://wtfismyip.com/text
IP_CACHE_TTL=30m

# Performance optimization settings
MAX_WORKERS=5
IDLE_TIMEOUT=1m
LAZY_CHECK_INTERVAL=2m
